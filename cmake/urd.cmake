option(covoxslam_enable_urd "Enable external SoA collections" OFF)
set(covoxslam_urd_path "../urd-cpp" CACHE STRING "Relative external collection source path")
if(covoxslam_enable_urd)
    cmake_path(ABSOLUTE_PATH covoxslam_urd_path BASE_DIRECTORY "${PROJECT_SOURCE_DIR}"
        NORMALIZE OUTPUT_VARIABLE covoxslam_urd_source)
    set(covoxslam_urd_include "${covoxslam_urd_source}/src/urd/include")
    file(GLOB_RECURSE covoxslam_urd_headers CONFIGURE_DEPENDS RELATIVE "${covoxslam_urd_include}"
        "${covoxslam_urd_include}/*.hpp" "${covoxslam_urd_include}/*.h")
    list(SORT covoxslam_urd_headers)
    set(covoxslam_urd_identity "")
    foreach(header IN LISTS covoxslam_urd_headers)
        file(SHA256 "${covoxslam_urd_include}/${header}" hash)
        string(APPEND covoxslam_urd_identity "${header}:${hash}\n")
    endforeach()
    string(SHA256 covoxslam_urd_hash "${covoxslam_urd_identity}")
    add_library(covoxslam_urd INTERFACE)
    target_include_directories(covoxslam_urd SYSTEM INTERFACE "${covoxslam_urd_include}")
    target_compile_definitions(covoxslam_urd INTERFACE covoxslam_has_urd=1)
    target_link_libraries(covoxslam_core PUBLIC covoxslam_urd)
    if(MSVC)
        target_compile_options(covoxslam_urd INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:/Zc:preprocessor>")
    endif()
endif()

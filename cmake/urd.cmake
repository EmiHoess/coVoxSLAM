option(covoxslam_enable_urd "Enable external SoA collections" OFF)
set(covoxslam_urd_path "../../eh/urd" CACHE STRING "Relative external URD source path")
if(covoxslam_enable_urd)
    cmake_path(ABSOLUTE_PATH covoxslam_urd_path BASE_DIRECTORY "${PROJECT_SOURCE_DIR}"
        NORMALIZE OUTPUT_VARIABLE covoxslam_urd_source)
    set(covoxslam_urd_include "${covoxslam_urd_source}/src/urd/include")
    if(NOT EXISTS "${covoxslam_urd_source}/CMakeLists.txt" OR
        NOT EXISTS "${covoxslam_urd_include}/urd/reflection.hpp")
        message(FATAL_ERROR "covoxslam_urd_path must select https://github.com/EmiHoess/urd with the public reflection API")
    endif()
    block()
        set(urd_install OFF)
        set(structured_layout_build_experimental OFF)
        set(structured_layout_build_property_views OFF)
        set(structured_layout_build_reflected_views OFF)
        set(structured_layout_build_generated_union_views OFF)
        add_subdirectory("${covoxslam_urd_source}" "${PROJECT_BINARY_DIR}/external/urd" SYSTEM)
    endblock()
    add_library(covoxslam_urd INTERFACE)
    target_link_libraries(covoxslam_urd INTERFACE urd::urd)
    target_compile_definitions(covoxslam_urd INTERFACE covoxslam_has_urd=1)
    target_link_libraries(covoxslam_core PUBLIC covoxslam_urd)
    if(MSVC)
        target_compile_options(covoxslam_urd INTERFACE "$<$<COMPILE_LANGUAGE:CXX>:/Zc:preprocessor>")
    endif()
endif()
